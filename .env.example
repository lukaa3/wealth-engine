# Copy to .env.local for local development (never commit real keys).
# Everything prefixed VITE_ is compiled into the PUBLIC JavaScript bundle.

# Supabase (safe to expose: the anon key is read-only under the RLS policies in supabase/schema.sql)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: default watchlist (comma-separated)
VITE_WATCHLIST=

# Optional, LOCAL TESTING ONLY. On GitHub Pages these would be visible to anyone.
# For the live site, enter keys in the in-app Settings drawer (saved in your browser only)
# and put them in GitHub Actions secrets for the scheduled job.
VITE_FMP_API_KEY=
VITE_FINNHUB_API_KEY=
VITE_ALPHA_VANTAGE_API_KEY=

# Used only by scripts/update-screener.mjs (run via `npm run update-data` or the GitHub Action):
# FMP_API_KEY=  FINNHUB_API_KEY=  ALPHA_VANTAGE_API_KEY=  WATCHLIST=
# SUPABASE_URL=  SUPABASE_SERVICE_ROLE_KEY=   (service key = full write access; Actions secret only)
